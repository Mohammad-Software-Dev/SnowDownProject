; Engine configuration file.
; Snowdown — Godot 4.x provisional baseline.
; Prefer editing this file through the Godot editor when practical.

config_version=5

[application]

config/name="Snowdown"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

App="*res://src/autoload/app.gd"
GameConfig="*res://src/autoload/game_config.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[input]

move_forward={"deadzone": 0.2, "events": []}
move_backward={"deadzone": 0.2, "events": []}
move_left={"deadzone": 0.2, "events": []}
move_right={"deadzone": 0.2, "events": []}
jump={"deadzone": 0.2, "events": []}
sprint={"deadzone": 0.2, "events": []}
crouch_slide={"deadzone": 0.2, "events": []}
pack_interact={"deadzone": 0.2, "events": []}
throw_primary={"deadzone": 0.2, "events": []}
catch={"deadzone": 0.2, "events": []}
scoreboard={"deadzone": 0.2, "events": []}
pause={"deadzone": 0.2, "events": []}
debug_overlay={"deadzone": 0.2, "events": []}
reset_test={"deadzone": 0.2, "events": []}

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.025, 0.055, 0.085, 1)
